{
  "name": "morrow-workspace",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix express-jwt-sqlite && npm ci --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix express-jwt-sqlite",
    "dev:api": "npm start --prefix express-jwt-sqlite",
    "dev:web": "npm run dev --prefix frontend",
    "import:sqlite": "npm run import:sqlite --prefix express-jwt-sqlite"
  }
}
